    "QueueBlock": {
      "additionalProperties": false,
      "description": "Contract \u00a73: the adapter confirms delivery on `Started`, never on completion.\n\n`ackMode` was a legacy `onComplete` selector (old-ach-agent) with no equivalent here \u2014\nthere is exactly one ACK semantic contract-wide, so it is not a configurable field.",
      "properties": {
        "type": {
          "const": "redis",
          "default": "redis",
          "title": "Type",
          "type": "string"
        },
        "key": {
          "title": "Key",
          "type": "string"
        }
      },
      "required": [
        "key"
      ],
      "title": "QueueBlock",
      "type": "object"
    },
    "RoutingBlock": {
      "additionalProperties": false,
      "description": "`channels[].routing` (contract \u00a72) \u2014 both overrides optional and independent.\n\nAn omitted override keeps the adapter default (generic webhook and queue have no default\nsession and require `sessionKey`); a present one must be a non-empty template string.\n`workspaceKey: session` is a reserved keyword: one workspace per session.\nTemplate syntax/rendering is an adapter concern (Task 3), not validated here.",
      "properties": {
        "workspaceKey": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "title": "Workspacekey"
        },
        "sessionKey": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "title": "Sessionkey"
        }
      },
      "title": "RoutingBlock",
      "type": "object"
    },
    "ScriptBlock": {
      "additionalProperties": false,
      "description": "Base shape for `channels[].script` (webhook-script handler) and `handoff` (below).\n\n`env` carries literal selected values; `secretEnv` carries private alias NAMES only\n(contract \u00a711: \"Handoff/script env contiene literales seleccionados\" /\n\"secretEnv.<nombre>: {env: ...} contienen solo aliases privados\").",
      "properties": {
        "script": {
          "title": "Script",
          "type": "string"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Env",
          "type": "object"
        },
        "secretEnv": {
          "additionalProperties": {
            "$ref": "#/$defs/SecretAlias"
          },
          "title": "Secretenv",
          "type": "object"
        },
        "timeoutSeconds": {
          "default": 120,
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Timeoutseconds",
          "type": "integer"
        }
      },
      "required": [
        "script"
      ],
      "title": "ScriptBlock",
      "type": "object"
    },
    "SecretAlias": {
      "additionalProperties": false,
      "description": "A private environment-variable NAME the Harness/control pod resolves \u2014 never a value.\n\nWire shape for `ach.identity`, `handoff.secretEnv.<name>`: `{\"env\": \"ACH_SECRET_...\"}`.",
      "properties": {
        "env": {
          "title": "Env",
          "type": "string"
        }
      },
      "required": [
        "env"
      ],
      "title": "SecretAlias",
      "type": "object"
    },
    "SessionPolicyBlock": {
