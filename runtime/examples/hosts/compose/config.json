{
  "schemaVersion": "workspace-v2",
  "agent": {"name": "compose-example", "namespace": "local", "uid": "6b0c1c3e-5d1e-4f7a-9a52-2f0f7d3b8c11"},
  "configVersion": "17e5cbe9502a54d097aed8347cf5f184cc936d13a4b16ace7f1424bc80ae92cb",
  "ach": {
    "baseUrl": "http://ach-stub:9000",
    "environment": "local",
    "identity": {"env": "ACH_SECRET_IDENTITY"},
    "capability": {"filter": {"exclude": {"tools": [], "mcpServers": [], "skills": []}}}
  },
  "model": {"name": "local-model", "type": "openai", "params": {}, "thinking": {"enabled": false, "effort": null}},
  "engine": {
    "env": {},
    "startupTimeoutSeconds": 60,
    "compaction": {"auto": true, "keep": {"tokens": 8000}, "buffer": 20000}
  },
  "limits": {
    "maxActiveWorkspaces": 2, "maxConcurrentInvocations": 2, "maxConcurrentScripts": 1,
    "maxInvocationSeconds": 600, "maxQueuedTotal": 20, "idempotencyWindowSeconds": 3600, "maxSteps": 30
  },
  "workspace": {
    "idleTimeoutSeconds": 6, "shutdownTimeoutSeconds": 60, "maxConcurrentSessions": 1,
    "persistence": {"enabled": true, "retentionDays": 7},
    "session": {"idleTimeoutSeconds": 3, "persistence": {"enabled": true, "retentionDays": 7}}
  },
  "artifacts": {"enabled": false, "maxArtifactBytes": 104857600, "retentionDays": 7},
  "channels": [
    {
      "name": "tasks",
      "type": "webhook",
      "concurrency": 1,
      "source": "generic",
      "routing": {"sessionKey": "{{ payload.session }}"},
      "prompt": "{{ payload.task }}",
      "webhook": {"auth": {"type": "header_token", "env": "ACH_SECRET_WEBHOOK", "header": "x-webhook-token"}}
    }
  ],
  "prompt": {"system": {"type": "text", "text": "You are a helpful assistant running in a local test setup. Answer briefly."}},
  "hooks": {"sessionStart": null, "sessionRestore": null, "sessionSuspend": null}
}
