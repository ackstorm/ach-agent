# Task 2 Python devtools stage: src/ach_runtime config schema/tests/gen_schema.py. Named and
# NOT last — `docker build -f Dockerfile.devtools .` (no --target) still defaults to the final
# node stage below, so this does not change spike-opencode's image. Built explicitly via
# `make test-config` / `make gen-schema` / `make schema-check` with --target python-config.
FROM python:3.13-alpine AS python-config

WORKDIR /work

RUN apk add --no-cache tzdata

COPY pyproject.toml ./
COPY src/ ./src/
RUN pip install --no-cache-dir -e ".[dev]"

COPY scripts/ ./scripts/
COPY tests/ ./tests/
COPY docs/schemas/ ./docs/schemas/
COPY examples/ ./examples/

CMD ["pytest", "tests/config", "-q"]

# Task 4 Python+Node devtools stage: execution/ + engine/ + plugins/managed-config/, run via
# `make test-execution` (--target python-execution). Combines the pinned real OpenCode v2
# binary (for the focused native adapter integration tests) with the Python runtime under
# test. npm install is placed before the Python COPY layers so editing execution/engine code
# does not invalidate the (network-dependent) binary install on every iteration.
FROM node:22-alpine AS python-execution

WORKDIR /work

RUN apk add --no-cache python3 py3-pip git tzdata

RUN apk add --no-cache tmux
# One install: a second `npm install --no-save` prunes what the first one added.
RUN npm install --no-save @opencode/cli@2.2.5 @pi-in-go/pig@0.7.0 @earendil-works/pi-coding-agent@1.5.0 \
    && ./node_modules/@opencode/cli/bin/opencode.exe --version \
    && ./node_modules/.bin/pig --version | grep -Fx "0.7.0+1.5.0" \
    && ./node_modules/.bin/pi --version | grep -Fx "1.5.0"
ENV OPENCODE_BIN=/work/node_modules/@opencode/cli/bin/opencode.exe
ENV PIG_BIN=/work/node_modules/.bin/pig UPSTREAM_PI_BIN=/work/node_modules/.bin/pi

COPY pyproject.toml ./
COPY src/ ./src/
RUN pip install --no-cache-dir --break-system-packages -e ".[dev]"

COPY plugins/ ./plugins/
COPY tests/ ./tests/

CMD ["pytest", "tests/execution", "tests/engine", "-q"]
