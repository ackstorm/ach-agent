  "additionalProperties": false,
  "description": "The complete resolved wire object `W` (contract \u00a75/\u00a711) minus no field at all.\n\n`configVersion` IS a member of this model (and of W) \u2014 compute_config_version() only\nexcludes it from the bytes being hashed, it is not absent from the schema.",
  "properties": {
    "schemaVersion": {
      "const": "workspace-v2",
      "title": "Schemaversion",
      "type": "string"
    },
    "agent": {
      "$ref": "#/$defs/AgentIdentity"
    },
    "configVersion": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Configversion",
      "type": "string"
    },
    "ach": {
      "$ref": "#/$defs/AchBlock"
    },
    "model": {
      "$ref": "#/$defs/ModelBlock"
    },
    "engine": {
      "$ref": "#/$defs/EngineBlock"
    },
    "limits": {
      "$ref": "#/$defs/LimitsBlock"
    },
    "workspace": {
      "$ref": "#/$defs/WorkspaceBlock"
    },
    "artifacts": {
      "$ref": "#/$defs/ArtifactsBlock"
    },
    "channels": {
      "items": {
        "$ref": "#/$defs/ChannelConfig"
      },
      "title": "Channels",
      "type": "array"
    },
    "prompt": {
      "anyOf": [
        {
          "$ref": "#/$defs/PromptBlock"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "hooks": {
      "$ref": "#/$defs/HooksBlock"
    },
    "memory": {
      "anyOf": [
        {
          "$ref": "#/$defs/AchMemoryMemory"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "infrastructure": {
      "$ref": "#/$defs/InfrastructureBlock"
    }
  },
  "required": [
    "schemaVersion",
    "agent",
    "configVersion",
    "ach",
    "model",
    "engine",
    "limits",
    "workspace",
    "artifacts"
  ],
  "type": "object",
  "allOf": [
    {
      "if": {
        "required": [
          "channels"
        ],
        "properties": {
          "channels": {
            "contains": {
              "type": "object",
              "required": [
                "handoff"
              ],
              "properties": {
                "handoff": {
                  "not": {
                    "type": "null"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "workspace": {
            "type": "object",
            "properties": {
              "maxConcurrentSessions": {
                "const": 1
              }
            }
          }
        }
      }
    }
  ]
}
