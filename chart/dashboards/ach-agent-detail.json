      "targets": [
        {
          "refId": "A",
          "expr": "{namespace=~\"$namespace\", pod=~\"${pod:regex}\", container=\"agent\"} |= \"\\\"invocation completed\\\"\" | json | line_format \"{{.channel}}  {{.outcome}}  {{.model}}  {{ if .duration_ms }}{{ divf .duration_ms 1000 | printf \\\"%.1f\\\" }}s{{ end }}  in={{.usage_input}} out={{.usage_output}} cost={{.usage_cost_usd}}  event={{.event_id}}  actor={{.actor}}\"",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
